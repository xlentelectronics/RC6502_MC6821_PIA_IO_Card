1 PRINT CHR$(27);"[2J"; : PRINT CHR$(27);"[1;1H"
10 PRINT "* * * MC6821 PIA IO RUNNING LIGHT * * *" : PRINT
15 PRINT "    * * * X-LENT ELECTRONICS * * *" : PRINT
20 INPUT "ENTER MC6821 PIA IO BASE ADDRESS $<ADDRESS>:"; BA$
25 PRINT "BASE ADDRES IS: ";BA$
30 IF BA$ = "$C000" THEN BA = 49152
35 IF BA$ = "$B000" THEN BA = 45056
40 IF BA$ = "$A000" THEN BA = 40960
45 IF BA$ = "$9000" THEN BA = 36864
50 IF BA$ = "$8000" THEN BA = 32768
55 REM -- INITIALIZE MC6521 PIA --
60 POKE BA+1, 0		: REM CRA address 0xC001. Select DDRA
70 POKE BA, 255	: REM DDRA address 0xC000. Set DDRA as OUTPUT 
80 POKE BA+1, 4		: REM Select DRA register
90 POKE BA, 255	: REM Set DRA OUTPUTS to 1, LEDS are OFF
100 POKE BA+3, 0		: REM CRB ADDRESS 0xC003. Select DDRB
110 POKE BA+2, 255	: REM DDRB ADDRES 0xC002. Set DDRB as OUTPUT	
120 POKE BA+3, 4		: REM Select DRB register
130 POKE BA+2, 255	: REM Set DRB OUTPUTS to 1, LEDS are OFF	
140 REM -- START RUNNINGLIGHT --
150 REM -- LEFT TO RIGHT -- 
160 FOR I = 0 TO 7
170 X = (255 - INT(2^I))
180 POKE BA, X
190 GOSUB 300
200 NEXT I
210 REM -- RIGHT TO LEFT --
220 FOR I = 6 TO 1 STEP -1
230 X = (255 - INT(2^I))
240 POKE BA, X
250 GOSUB 300
260 NEXT I
270 GOTO 110
300 REM GOSUB -- DELAY --
310 FOR D = 1 TO 25
320 NEXT D
330 RETURN
